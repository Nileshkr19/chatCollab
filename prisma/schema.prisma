generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum userStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum authProvider {
  LOCAL
  GOOGLE
  GITHUB
}

model User {
  id          String       @id @default(uuid())
  firstName   String
  lastName    String
  username    String       @unique
  avatar_url  String?
  email       String       @unique
  password    String?
  provider    authProvider @default(LOCAL)
  status      userStatus   @default(ACTIVE)
  is_verified Boolean      @default(false)
  last_seen   DateTime?
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  deleted_at  DateTime?

  ownedWorkspaces Workspace[] @relation("OwnedWorkspaces")
  workspaceMembers WorkspaceMember[]
  notifications Notification[]
  notificationPreferences NotificationPreference?
}

enum WorkspaceRole {
  OWNER
  MANAGER
  MEMBER
  GUEST
}

model Workspace {
  id String @id @default(uuid())
  name String
  slug String @unique
  logo_url String?
  owner_id String
  owner User @relation("OwnedWorkspaces", fields:[owner_id], references: [id])
  members WorkspaceMember[]
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  deleted_at DateTime?

  @@index([owner_id])
}

model WorkspaceMember {
  id String @id @default (uuid())
  workspace_id String
  workspace Workspace @relation(fields: [workspace_id], references: [id])
  user_id String
  user User @relation(fields: [user_id], references: [id])
  role WorkspaceRole @default(MEMBER)
  joined_at DateTime @default(now())
  invited_by String?
  is_active Boolean @default(true)

  @@unique([workspace_id, user_id])
  @@index([workspace_id])
  @@index([user_id])
}

model Notification {  
  id String @id @default(uuid())
  userId String @db.uuid()
  type String
  title String
  content String?
  isRead Boolean @default(false)
  readAt DateTime?
  createdAt DateTime @default(now())
  expireAt DateTime @default(dbgenerated("CURRENT_TIMESTAMP + INTERVAL '7 days'"))

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([expireAt])
}

model NotificationPreference {
  id String @id @default(uuid())
  userId String @db.uuid()

  emailTaskAssigned Boolean @default(true)
  emailTaskUpdated Boolean @default(true)
  emailMessageMention Boolean @default(true)

  pushTaskAssigned Boolean @default(true)
  pushMessageMention Boolean @default(true)

  quietHoursEnabled Boolean @default(false)
  quietHoursStart Int? // 0-23
  quietHoursEnd Int?   // 0-23

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

}